rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ヘルパー関数：ログインユーザーが管理者かどうか
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.isAdmin == true;
    }

    // 開発/テストモード: Emulatorで認証なしアクセスを許可
    function isDevelopment() {
      return request.auth == null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // membersコレクション
    match /members/{uid} {
      // 自分の情報は読み取り可能、管理者は全て読み書き可能
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /presentations/{id} {
      allow read, write: if true; // Dev mode: allow all
    }

    match /events/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /teaParties/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 設定は全員読み取り可能、ローカル開発では全て書き込み可能
    match /settings/{doc} {
      allow read: if request.auth != null || request.auth == null;
      allow write: if true; // Dev mode: allow all writes
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
